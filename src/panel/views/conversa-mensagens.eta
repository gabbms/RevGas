<% if (it.mensagens.length === 0) { %><p class="empty">Nenhuma mensagem nos últimos 30 dias.</p><% } %>
<% for (const m of it.mensagens) { %>
  <div class="msg msg-<%= m.autor %>">
    <p class="msg-who"><%= m.rotulo %> · <span class="num"><%= m.quando %></span></p>
    <p class="msg-text"><% if (m.audio) { %><span class="msg-audio"><%~ it.icons.audio %>Áudio transcrito</span><% } %><%= m.texto %></p>
  </div>
<% } %>
