<% if (it.mensagens.length === 0) { %><p class="vazio">Nenhuma mensagem nos últimos 30 dias.</p><% } %>
<% for (const m of it.mensagens) { %>
  <div class="msg msg-<%= m.autor %>">
    <div class="msg-quem"><%= m.rotulo %> · <%= m.quando %></div>
    <div class="msg-texto"><% if (m.audio) { %>🎤 <% } %><%= m.texto %></div>
  </div>
<% } %>
