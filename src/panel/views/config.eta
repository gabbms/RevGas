<%
const erro = (campo) => it.erros[campo] || [];
const invalido = (campo) => erro(campo).length > 0 ? ' aria-invalid="true" aria-describedby="erro-' + campo + '"' : '';
const marcado = (campo) => it.v[campo] === 'on' ? 'checked' : '';
const totalErros = Object.keys(it.erros).length;
%>
<div class="title-row">
  <div>
    <h1><%= it.titulo %></h1>
    <p class="sub">O bot só usa o que está aqui: preços, horários e bairros não ficam no código.</p>
  </div>
</div>

<% if (it.salvo) { %><p class="notice notice-pos" role="status">Configurações salvas. O bot já usa os valores novos.</p><% } %>
<% if (totalErros > 0) { %><p class="notice notice-neg" role="alert">Não salvei: corrija os <%= totalErros === 1 ? 'campo marcado' : totalErros + ' campos marcados' %> abaixo.</p><% } %>
<% if (it.avisos.length > 0) { %>
<div class="notice notice-warn" role="note">
  <% for (const a of it.avisos) { %><p><%= a %></p><% } %>
</div>
<% } %>
<% if (it.modelosFaltando.length > 0) { %>
<div class="notice notice-warn" role="note">
  <p><strong>Modelos de mensagem faltando.</strong> Fora da janela de 24 horas o WhatsApp só entrega mensagens por modelo aprovado. Peça para configurar no servidor:</p>
  <ul>
    <% for (const m of it.modelosFaltando) { %><li><code><%= m.variavel %></code>: <%= m.efeito %></li><% } %>
  </ul>
</div>
<% } %>

<form method="post" action="/painel/config" class="config" novalidate>

  <section class="setting" aria-labelledby="s-loja">
    <div class="setting-label">
      <h2 id="s-loja">Loja</h2>
      <p class="sub">O nome aparece nas mensagens do bot; o endereço, quando o cliente quer retirar.</p>
    </div>
    <div class="setting-panel">
      <div class="field">
        <label for="nomeLoja">Nome da loja</label>
        <input class="input" id="nomeLoja" name="nomeLoja" value="<%= it.v.nomeLoja %>"<%~ invalido('nomeLoja') %>>
        <% for (const m of erro('nomeLoja')) { %><p class="field-error" id="erro-nomeLoja"><%= m %></p><% } %>
      </div>
      <div class="field">
        <label for="enderecoLoja">Endereço da loja</label>
        <input class="input" id="enderecoLoja" name="enderecoLoja" value="<%= it.v.enderecoLoja %>"<%~ invalido('enderecoLoja') %>>
        <% for (const m of erro('enderecoLoja')) { %><p class="field-error" id="erro-enderecoLoja"><%= m %></p><% } %>
      </div>
    </div>
  </section>

  <section class="setting" aria-labelledby="s-precos">
    <div class="setting-label">
      <h2 id="s-precos">Preços e entrega</h2>
      <p class="sub">Preço do botijão P13. No completo o cliente leva o casco junto.</p>
    </div>
    <div class="setting-panel">
      <div class="fields-3">
        <div class="field">
          <label for="precoRecarga">Recarga (troca)</label>
          <div class="affix"><span>R$</span><input class="input num" id="precoRecarga" name="precoRecarga" inputmode="decimal" value="<%= it.v.precoRecarga %>"<%~ invalido('precoRecarga') %>></div>
          <% for (const m of erro('precoRecarga')) { %><p class="field-error" id="erro-precoRecarga"><%= m %></p><% } %>
        </div>
        <div class="field">
          <label for="precoCompleto">Botijão completo</label>
          <div class="affix"><span>R$</span><input class="input num" id="precoCompleto" name="precoCompleto" inputmode="decimal" value="<%= it.v.precoCompleto %>"<%~ invalido('precoCompleto') %>></div>
          <% for (const m of erro('precoCompleto')) { %><p class="field-error" id="erro-precoCompleto"><%= m %></p><% } %>
        </div>
        <div class="field">
          <label for="previsaoEntregaMin">Previsão de entrega</label>
          <div class="affix affix-end"><input class="input num" id="previsaoEntregaMin" name="previsaoEntregaMin" inputmode="numeric" value="<%= it.v.previsaoEntregaMin %>"<%~ invalido('previsaoEntregaMin') %>><span>min</span></div>
          <% for (const m of erro('previsaoEntregaMin')) { %><p class="field-error" id="erro-previsaoEntregaMin"><%= m %></p><% } %>
        </div>
      </div>
      <p class="hint">A previsão é o que o bot promete ao cliente e o que o relógio dos pedidos usa para marcar atraso.</p>
    </div>
  </section>

  <section class="setting" id="horario" aria-labelledby="s-horario">
    <div class="setting-label">
      <h2 id="s-horario">Horário de funcionamento</h2>
      <p class="sub">Fora do horário o bot não promete entrega: ele agenda o pedido para a abertura.</p>
    </div>
    <div class="setting-panel">
      <div class="days">
        <% for (const d of it.dias) { %>
          <div class="day" data-dia="<%= d.id %>">
            <span class="day-name"><%= d.rotulo %></span>
            <label class="visually-hidden" for="<%= d.id %>_abre"><%= d.rotulo %>: abre</label>
            <input class="input num" type="time" id="<%= d.id %>_abre" name="<%= d.id %>_abre" value="<%= it.v[d.id + '_abre'] %>"<%~ invalido(d.id) %>>
            <span class="day-sep">até</span>
            <label class="visually-hidden" for="<%= d.id %>_fecha"><%= d.rotulo %>: fecha</label>
            <input class="input num" type="time" id="<%= d.id %>_fecha" name="<%= d.id %>_fecha" value="<%= it.v[d.id + '_fecha'] %>"<%~ invalido(d.id) %>>
            <label class="check day-closed"><input type="checkbox" data-fechado name="<%= d.id %>_fechado" value="on" <%= marcado(d.id + '_fechado') %>> Fechado</label>
          </div>
          <% for (const m of erro(d.id)) { %><p class="field-error" id="erro-<%= d.id %>"><%= d.rotulo %>: <%= m %></p><% } %>
        <% } %>
      </div>
    </div>
  </section>

  <section class="setting" aria-labelledby="s-bairros">
    <div class="setting-label">
      <h2 id="s-bairros">Bairros atendidos</h2>
      <p class="sub">Para outro bairro o bot oferece retirada na loja.</p>
    </div>
    <div class="setting-panel">
      <div class="field">
        <label for="bairros">Um bairro por linha</label>
        <textarea class="input" id="bairros" name="bairros" rows="6"<%~ invalido('bairros') %>><%= it.v.bairros %></textarea>
        <% for (const m of erro('bairros')) { %><p class="field-error" id="erro-bairros"><%= m %></p><% } %>
      </div>
    </div>
  </section>

  <section class="setting" aria-labelledby="s-pagamentos">
    <div class="setting-label">
      <h2 id="s-pagamentos">Formas de pagamento</h2>
      <p class="sub">No Pix antecipado o bot manda a chave e repassa o comprovante ao entregador. Gás do Povo tem seção própria.</p>
    </div>
    <div class="setting-panel">
      <fieldset class="checks">
        <legend class="visually-hidden">Formas de pagamento aceitas</legend>
        <% for (const p of it.pagamentos) { %>
          <label class="check"><input type="checkbox" name="pagamentos" value="<%= p.id %>" <%= it.v.pagamentos.includes(p.id) ? 'checked' : '' %>> <%= p.rotulo %></label>
        <% } %>
      </fieldset>
      <% for (const m of erro('pagamentos')) { %><p class="field-error" id="erro-pagamentos"><%= m %></p><% } %>
      <div class="field">
        <label for="chavePix">Chave Pix</label>
        <input class="input" id="chavePix" name="chavePix" value="<%= it.v.chavePix %>" aria-describedby="chavePix-hint<%= erro('chavePix').length ? ' erro-chavePix' : '' %>"<%~ erro('chavePix').length ? ' aria-invalid="true"' : '' %>>
        <p class="hint" id="chavePix-hint">Obrigatória para aceitar Pix antecipado.</p>
        <% for (const m of erro('chavePix')) { %><p class="field-error" id="erro-chavePix"><%= m %></p><% } %>
      </div>
    </div>
  </section>

  <section class="setting" aria-labelledby="s-destino">
    <div class="setting-label">
      <h2 id="s-destino">Para onde vão os pedidos</h2>
      <p class="sub">Cada pedido confirmado chega pelo WhatsApp. Os alertas do bot vão sempre para o seu número.</p>
    </div>
    <div class="setting-panel">
      <div class="field">
        <label for="destinoPedidos">Pedidos novos vão</label>
        <select class="input" id="destinoPedidos" name="destinoPedidos"<%~ invalido('destinoPedidos') %>>
          <option value="entregadores" <%= it.v.destinoPedidos === 'entregadores' ? 'selected' : '' %>>Para os entregadores</option>
          <option value="dono" <%= it.v.destinoPedidos === 'dono' ? 'selected' : '' %>>Só para o meu WhatsApp</option>
        </select>
        <% for (const m of erro('destinoPedidos')) { %><p class="field-error" id="erro-destinoPedidos"><%= m %></p><% } %>
      </div>
      <div class="field">
        <label for="telefoneDono">Seu WhatsApp</label>
        <input class="input num" id="telefoneDono" name="telefoneDono" inputmode="tel" placeholder="86 99999-0000" value="<%= it.v.telefoneDono %>"<%~ invalido('telefoneDono') %>>
        <% for (const m of erro('telefoneDono')) { %><p class="field-error" id="erro-telefoneDono"><%= m %></p><% } %>
      </div>
      <div class="field">
        <label for="entregadores">Entregadores</label>
        <textarea class="input" id="entregadores" name="entregadores" rows="4" placeholder="João; 86 99999-0000" aria-describedby="entregadores-hint<%= erro('entregadores').length ? ' erro-entregadores' : '' %>"<%~ erro('entregadores').length ? ' aria-invalid="true"' : '' %>><%= it.v.entregadores %></textarea>
        <p class="hint" id="entregadores-hint">Um por linha: nome; telefone com DDD. Cada um precisa mandar um "oi" para o número do bot antes do primeiro pedido.</p>
        <% for (const m of erro('entregadores')) { %><p class="field-error" id="erro-entregadores"><%= m %></p><% } %>
      </div>
    </div>
  </section>

  <section class="setting" aria-labelledby="s-gdp">
    <div class="setting-label">
      <h2 id="s-gdp">Gás do Povo</h2>
      <p class="sub">O cliente paga só o casco (no completo) e a taxa de entrega. O bot nunca guarda o código do SMS.</p>
    </div>
    <div class="setting-panel">
      <label class="check switch-row"><input class="switch" type="checkbox" name="gdpAceita" value="on" <%= marcado('gdpAceita') %>> Atendo pelo Gás do Povo</label>
      <div class="fields-2">
        <div class="field">
          <label for="gdpModalidade">Como atende</label>
          <select class="input" id="gdpModalidade" name="gdpModalidade"<%~ invalido('gdpModalidade') %>>
            <option value="entrega" <%= it.v.gdpModalidade === 'entrega' ? 'selected' : '' %>>Entrega em casa</option>
            <option value="retirada" <%= it.v.gdpModalidade === 'retirada' ? 'selected' : '' %>>Só retirada na loja</option>
          </select>
          <% for (const m of erro('gdpModalidade')) { %><p class="field-error" id="erro-gdpModalidade"><%= m %></p><% } %>
        </div>
        <div class="field">
          <label for="gdpTaxa">Taxa de entrega</label>
          <div class="affix"><span>R$</span><input class="input num" id="gdpTaxa" name="gdpTaxa" inputmode="decimal" value="<%= it.v.gdpTaxa %>"<%~ invalido('gdpTaxa') %>></div>
          <% for (const m of erro('gdpTaxa')) { %><p class="field-error" id="erro-gdpTaxa"><%= m %></p><% } %>
        </div>
      </div>
    </div>
  </section>

  <section class="setting" aria-labelledby="s-lembretes">
    <div class="setting-label">
      <h2 id="s-lembretes">Lembretes e fuso</h2>
      <p class="sub">O bot lembra o cliente de comprar de novo quando o gás deve estar acabando, pelo histórico de pedidos.</p>
    </div>
    <div class="setting-panel">
      <label class="check switch-row"><input class="switch" type="checkbox" name="lembretesAtivos" value="on" <%= marcado('lembretesAtivos') %>> Lembrar clientes de comprar de novo</label>
      <div class="field">
        <label for="fuso">Fuso horário</label>
        <input class="input" id="fuso" name="fuso" value="<%= it.v.fuso %>" aria-describedby="fuso-hint"<%~ erro('fuso').length ? ' aria-invalid="true"' : '' %>>
        <p class="hint" id="fuso-hint">Teresina usa America/Fortaleza.</p>
        <% for (const m of erro('fuso')) { %><p class="field-error" id="erro-fuso"><%= m %></p><% } %>
      </div>
    </div>
  </section>

  <div class="savebar">
    <p class="hint">As alterações valem para as próximas conversas do bot.</p>
    <button type="submit" class="btn primary">Salvar configurações</button>
  </div>
</form>
