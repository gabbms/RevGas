<h1 class="page-title"><%= it.titulo %></h1>
<% if (it.erro) { %><p class="notice notice-neg" role="alert"><%= it.erro %></p><% } %>
<div id="lista" hx-get="/painel/pedidos/lista<%= it.filtro ? '?status=' + it.filtro : '' %>" hx-trigger="every 10s [!document.querySelector('#lista details[open]')]" hx-swap="innerHTML">
  <%~ include('_lista', it) %>
</div>
