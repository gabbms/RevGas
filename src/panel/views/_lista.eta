<div class="board-head">
  <p class="board-summary"><%= it.achado %></p>
  <p class="stamp mono">Atualizado às <%= it.atualizado %></p>
</div>

<div class="board">
  <% for (const c of it.colunas) { %>
    <section class="col" aria-labelledby="col-<%= c.id %>">
      <header class="col-head">
        <span class="col-dot" style="background:<%= c.cor %>" aria-hidden="true"></span>
        <h2 id="col-<%= c.id %>"><%= c.rotulo %></h2>
        <span class="col-count num"><%= c.cartoes.length %></span>
        <span class="col-hint"><%= c.dica %></span>
      </header>
      <div class="col-body">
        <% for (const p of c.cartoes) { %>
          <article class="ocard<%= p.atrasado ? ' is-late' : '' %><%= it.selecionadoId === p.id ? ' is-selected' : '' %><%= p.status === 'cancelado' ? ' is-cancelled' : '' %>">
            <a class="ocard-link" href="/painel/pedidos?pedido=<%= p.id %>">
              <span class="ocard-top">
                <%~ it.icons.conversas %>
                <strong class="mono">#<%= p.id %></strong>
                <% if (p.tempo) { %><span class="mono ocard-time"><% if (p.aberto) { %><%~ it.icons.relogio %><% } %><%= p.tempo %></span><% } %>
              </span>
              <span class="ocard-name"><%= p.cliente %></span>
              <span class="ocard-addr"><%= p.tipo === 'retirada' ? 'Retirada na loja' : (p.endereco ?? 'Sem endereço') %></span>
              <span class="ocard-items"><%= p.resumo %></span>
              <span class="ocard-pay">
                <%~ it.icons[p.pagIcone] %><span class="ocard-pay-text"><%= p.pagamento %><% if (p.troco) { %> · troco p/ <%= p.troco %><% } %></span>
                <span class="ocard-total num"><%= p.total %></span>
              </span>
              <% if (p.selos.length > 0) { %>
                <span class="tags"><% for (const s of p.selos) { %><span class="tag tag-<%= s.tom %>"><%= s.texto %></span><% } %></span>
              <% } %>
              <% if (p.entregador) { %>
                <span class="ocard-driver"><span class="avatar avatar-sm"><%= p.iniciais %></span><%= p.entregador %></span>
              <% } %>
              <% if (p.status === 'cancelado') { %><span class="tags"><span class="tag tag-neutral">Cancelado</span></span><% } %>
            </a>
            <% if (p.principal) { %>
              <form class="ocard-action" method="post" action="/painel/pedidos/<%= p.id %>/status">
                <input type="hidden" name="status" value="<%= p.principal.status %>">
                <button type="submit" class="btn"><%~ it.icons[p.principal.icone] %><%= p.principal.rotulo %></button>
              </form>
            <% } %>
          </article>
        <% } %>
        <% if (c.cartoes.length === 0) { %><p class="col-empty"><%= c.vazio %></p><% } %>
      </div>
    </section>
  <% } %>
</div>
