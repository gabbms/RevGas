<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.titulo %> · <%= it.loja.nome %></title>
  <script>try{var t=localStorage.getItem('revgas-theme');if(t)document.documentElement.dataset.theme=t;if(localStorage.getItem('revgas-side')==='min')document.documentElement.dataset.side='min'}catch(e){}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/htmx.min.js" defer></script>
  <script src="/static/painel.js" defer></script>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <a class="brand" href="/painel">
      <span class="brand-mark"><%~ it.icons.chama %></span>
      <span class="brand-text"><strong>ÍRIS</strong><span>por <b>REVGÁS</b></span></span>
    </a>
    <nav class="nav" aria-label="Seções do painel">
      <% for (const n of it.nav) { const qtd = it.contagens[n.id] ?? 0; %>
        <a class="nav-item" href="<%= n.href %>" title="<%= n.label %>"<% if (n.id === it.active) { %> aria-current="page"<% } %>>
          <%~ it.icons[n.id] %><span class="nav-label"><%= n.label %></span><% if (qtd > 0) { %><span class="count<%= n.id === 'alertas' ? ' count-warn' : '' %>" aria-label="<%= qtd %> <%= n.id === 'alertas' ? 'abertos' : 'esperando' %>"><%= qtd %></span><% } %>
        </a>
      <% } %>
    </nav>
    <div class="sidebar-foot">
      <div class="bot-card">
        <p class="bot-title"><%= it.bot.titulo %></p>
        <p class="bot-sub"><%= it.bot.sub %></p>
      </div>
      <button class="side-toggle" type="button" data-side-toggle title="Recolher ou expandir o menu"><%~ it.icons.recolher %><span class="nav-label">Recolher menu</span></button>
    </div>
  </aside>

  <header class="topbar">
    <a class="brand brand-phone" href="/painel"><span class="brand-mark"><%~ it.icons.chama %></span></a>
    <div class="top-title">
      <div class="top-name"><%= it.titulo %></div>
      <div class="top-clock" data-relogio data-fuso="<%= it.loja.fuso %>"><%= it.loja.agora %></div>
    </div>
    <button class="btn btn-icon" type="button" data-theme-toggle title="Alternar tema claro e escuro" aria-label="Alternar tema claro e escuro"><%~ it.icons.tema %></button>
    <% if (it.loja.status.semHorario) { %>
      <a class="btn store store-off" href="/painel/config#horario"><span class="dot" aria-hidden="true"></span><span class="store-text"><%= it.loja.status.texto %></span></a>
    <% } else { %>
      <span class="btn store <%= it.loja.status.aberta ? 'store-on' : 'store-off' %>"><span class="dot" aria-hidden="true"></span><span class="store-text"><%= it.loja.status.texto %></span></span>
    <% } %>
    <form method="post" action="/logout" class="logout"><button class="btn btn-icon" type="submit" title="Sair" aria-label="Sair"><%~ it.icons.sair %></button></form>
  </header>

  <main class="sheet" id="conteudo">
    <%~ it.body %>
  </main>
</div>

<nav class="tabbar" aria-label="Seções do painel">
  <% for (const n of it.nav) { const qtd = it.contagens[n.id] ?? 0; %>
    <a href="<%= n.href %>"<% if (n.id === it.active) { %> aria-current="page"<% } %>>
      <span class="tab-icon"><%~ it.icons[n.id] %><% if (qtd > 0) { %><span class="count<%= n.id === 'alertas' ? ' count-warn' : '' %>" aria-label="<%= qtd %> <%= n.id === 'alertas' ? 'abertos' : 'esperando' %>"><%= qtd %></span><% } %></span>
      <span><%= n.curto %></span>
    </a>
  <% } %>
</nav>
</body>
</html>
