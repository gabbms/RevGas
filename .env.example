PORT=3000
DB_PATH=data/revgas.db
PUBLIC_URL=https://seu-dominio.example.com

# Qual WhatsApp usar: "meta" (API oficial, padrão) ou "waha" (não oficial, só para testes; veja docs/WAHA.md)
WA_PROVIDER=meta

# WhatsApp Cloud API (Meta). Obrigatório com WA_PROVIDER=meta
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0
# Modelos aprovados (pt_BR). PEDIDO e ALERTA são obrigatórios em produção;
# STATUS e LEMBRETE são fortemente recomendados (sem eles, só funciona na janela de 24h)
WA_TPL_PEDIDO=
WA_TPL_STATUS=
WA_TPL_ALERTA=
WA_TPL_LEMBRETE=

# WAHA (só com WA_PROVIDER=waha). Veja docs/WAHA.md
WAHA_URL=http://localhost:3001
# Gere dois textos aleatórios diferentes e longos
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_SESSION=default

# IA
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_EFFORT=medium

# Transcrição de áudio
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# Painel (senha com 12 caracteres ou mais)
PANEL_PASSWORD=
SESSION_SECRET=troque-por-uma-string-aleatoria-com-32-caracteres-ou-mais
